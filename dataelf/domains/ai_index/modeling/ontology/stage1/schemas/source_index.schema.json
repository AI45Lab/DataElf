{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dataelf:schema:source-index:v2",
  "type": "object",
  "required": ["schemaVersion", "sourceFingerprint", "documents", "records", "fragments", "pathProfiles", "relationComparisons", "entityProfiles", "metrics", "sourceIndexSha256"],
  "properties": {
    "schemaVersion": {"const": "dataelf-source-index.v2"},
    "sourceFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documents": {"type": "array"},
    "records": {"type": "array"},
    "fragments": {"type": "array"},
    "pathProfiles": {"type": "object"},
    "relationComparisons": {"type": "object"},
    "entityProfiles": {"type": "object"},
    "metrics": {"type": "object"},
    "sourceIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
