{
  "_source": "BerriAI/litellm — litellm/proxy/guardrails/guardrail_hooks/litellm_content_filter/patterns.json",
  "_source_url": "https://github.com/BerriAI/litellm/blob/main/litellm/proxy/guardrails/guardrail_hooks/litellm_content_filter/patterns.json",
  "_note": "Credential and secret leak patterns. aws_secret_key omitted (40-char base64 is too broad without context).",
  "patterns": [
    {
      "name": "aws_access_key",
      "display_name": "AWS Access Key",
      "pattern": "\\b(AKIA[0-9A-Z]{16})\\b",
      "description": "AWS access key IDs (AKIA prefix + 16 uppercase alphanumeric)"
    },
    {
      "name": "github_token",
      "display_name": "GitHub Personal Access Token",
      "pattern": "\\b(gh[ps]_[a-zA-Z0-9]{36})\\b",
      "description": "GitHub personal access tokens (ghp_ or ghs_ prefix)"
    },
    {
      "name": "slack_token",
      "display_name": "Slack API Token",
      "pattern": "\\b(xox[pboa]-[0-9]{10,13}-[0-9]{10,13}-[a-zA-Z0-9]{24,32})\\b",
      "description": "Slack API tokens (xoxp/xoxb/xoxa prefix)"
    },
    {
      "name": "generic_api_key",
      "display_name": "Generic API Key",
      "pattern": "\\b([Aa][Pp][Ii][-_]?[Kk][Ee][Yy][\\s:=]+['\"]?[A-Za-z0-9_\\-]{20,}['\"]?)\\b",
      "description": "Generic API key assignments (api_key = ..., apiKey: ...)"
    },
    {
      "name": "openai_api_key",
      "display_name": "OpenAI API Key",
      "pattern": "\\bsk-(?:[A-Za-z0-9]+-)*[A-Za-z0-9]{20,}\\b",
      "description": "OpenAI API keys (sk- prefix, including sk-proj-... and sk-svcacct-... formats)"
    },
    {
      "name": "private_key_header",
      "display_name": "PEM Private Key",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
      "description": "PEM-encoded private key headers"
    },
    {
      "name": "jwt_token",
      "display_name": "JWT Token",
      "pattern": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}\\b",
      "description": "JSON Web Tokens (three base64url segments starting with eyJ)"
    }
  ]
}
