{
  "_source": "BerriAI/litellm — litellm/proxy/guardrails/guardrail_hooks/litellm_content_filter/patterns.json",
  "_source_url": "https://github.com/BerriAI/litellm/blob/main/litellm/proxy/guardrails/guardrail_hooks/litellm_content_filter/patterns.json",
  "_note": "Selected PII-category patterns. CN patterns (cn_id_card, cn_phone, cn_bank_card) are project-specific additions.",
  "patterns": [
    {
      "name": "email",
      "display_name": "Email Address",
      "pattern": "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b",
      "description": "Detects email addresses"
    },
    {
      "name": "us_ssn",
      "display_name": "SSN (US Social Security Number)",
      "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "description": "US Social Security Numbers (XXX-XX-XXXX)"
    },
    {
      "name": "us_phone",
      "display_name": "Phone Number (US)",
      "pattern": "\\b(?:\\+?1[\\s.\\-]?)?\\(?([0-9]{3})\\)?[\\s.\\-]?([0-9]{3})[\\s.\\-]?([0-9]{4})\\b",
      "description": "US phone numbers in various formats"
    },
    {
      "name": "cn_id_card",
      "display_name": "Identity Card (China)",
      "pattern": "\\b[1-9]\\d{5}(?:18|19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]\\b",
      "description": "Chinese Resident ID Card (18-digit, checksum validated in checker)",
      "validator": "cn_id_checksum"
    },
    {
      "name": "cn_phone",
      "display_name": "Phone Number (China)",
      "pattern": "(?<!\\d)(?:\\+?86[\\s\\-]?)?1[3-9]\\d{9}(?!\\d)",
      "description": "Chinese mobile phone numbers"
    },
    {
      "name": "cn_bank_card",
      "display_name": "Bank Card (China)",
      "pattern": "\\b[1-9]\\d{15,18}\\b",
      "description": "Chinese bank card numbers (16-19 digits)"
    },
    {
      "name": "credit_card_visa",
      "display_name": "Credit Card (Visa)",
      "pattern": "\\b4\\d{3}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}\\b",
      "description": "Visa credit card numbers",
      "validator": "luhn"
    },
    {
      "name": "credit_card_mastercard",
      "display_name": "Credit Card (Mastercard)",
      "pattern": "\\b5[1-5]\\d{2}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}[\\s\\-]?\\d{4}\\b",
      "description": "Mastercard credit card numbers",
      "validator": "luhn"
    },
    {
      "name": "credit_card_amex",
      "display_name": "Credit Card (American Express)",
      "pattern": "\\b3[47]\\d{2}[\\s\\-]?\\d{6}[\\s\\-]?\\d{5}\\b",
      "description": "American Express credit card numbers",
      "validator": "luhn"
    },
    {
      "name": "iban",
      "display_name": "IBAN (International Bank Account Number)",
      "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b",
      "description": "IBANs (2-letter country code + 2 check digits + up to 30 alphanumeric)"
    },
    {
      "name": "ipv4",
      "display_name": "IP Address (IPv4)",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\b",
      "description": "IPv4 addresses (may indicate internal network exposure)"
    },
    {
      "name": "street_address",
      "display_name": "Street Address",
      "pattern": "\\b\\d{1,6}\\s+[A-Za-z0-9][A-Za-z0-9\\s.'\\-]*\\s+(?:Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Drive|Dr|Lane|Ln|Way|Court|Ct|Place|Pl|Circle|Cir)\\b",
      "description": "Street addresses (number + name + type suffix)"
    },
    {
      "name": "passport_cn",
      "display_name": "Passport (China)",
      "pattern": "\\b[EeGg]\\d{8}\\b",
      "description": "Chinese passport numbers (E/G prefix + 8 digits)"
    },
    {
      "name": "passport_us",
      "display_name": "Passport (US)",
      "pattern": "\\b([A-Z][0-9]{8}|[0-9]{9})\\b",
      "description": "US passport numbers (letter + 8 digits, or 9 digits)"
    },
    {
      "name": "passport_jp",
      "display_name": "Passport (Japan)",
      "pattern": "\\b[A-Z]{2}[0-9]{7}\\b",
      "description": "Japanese passport numbers (2 letters + 7 digits)"
    },
    {
      "name": "sg_nric",
      "display_name": "NRIC/FIN (Singapore)",
      "pattern": "\\b[STFGM]\\d{7}[A-Z]\\b",
      "description": "Singapore NRIC and FIN numbers"
    },
    {
      "name": "uae_emirates_id",
      "display_name": "Emirates ID (UAE)",
      "pattern": "\\b784-?\\d{4}-?\\d{7}-?\\d\\b",
      "description": "UAE Emirates ID (784-YYYY-NNNNNNN-C)"
    },
    {
      "name": "ca_sin",
      "display_name": "SIN (Canada Social Insurance Number)",
      "pattern": "\\b[1-9]\\d{2}[\\-\\s]\\d{3}[\\-\\s]\\d{3}\\b",
      "description": "Canadian Social Insurance Numbers"
    },
    {
      "name": "fr_nir",
      "display_name": "NIR (French Social Security Number)",
      "pattern": "\\b[12][0-9]{2}(0[1-9]|1[0-2])[0-9]{2}[0-9]{3}[0-9]{3}[0-9]{2}\\b",
      "description": "French National Identification Number (15 digits)"
    },
    {
      "name": "au_medicare",
      "display_name": "Medicare Number (Australia)",
      "pattern": "\\b(?:\\d{4}\\s?\\d{5}\\s?\\d{1}|\\d{11})\\b",
      "description": "Australian Medicare numbers"
    },
    {
      "name": "br_cpf",
      "display_name": "CPF (Brazil Personal Tax ID)",
      "pattern": "\\d{3}\\.\\d{3}\\.\\d{3}(-|/)\\d{2}",
      "description": "Brazilian CPF numbers (XXX.XXX.XXX-XX)"
    }
  ]
}
